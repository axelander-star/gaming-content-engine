# =====================================================================
# Gaming Content Engine – Beispielkonfiguration
# Kopieren nach .env und Werte setzen. Die .env wird NIE eingecheckt.
# Alle Werte mit "change-me" MÜSSEN vor dem Start ersetzt werden.
# =====================================================================

# --- Allgemein ---
APP_ENV=development            # development | staging | production
APP_NAME=gaming-content-engine
LOG_LEVEL=INFO
TZ=Europe/Berlin

# --- Sicherheit (Phase 2/3) ---
# Erzeugen z. B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
# Schlüssel zur Verschlüsselung gespeicherter Plattform-Tokens (Fernet, 32 Byte base64)
# Erzeugen mit: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=change-me
# Nur während eines Schlüsselwechsels: vorherige(r) Schlüssel, kommagetrennt (Phase 15).
# Danach `python -m app.rotate_credentials` ausführen und den Eintrag wieder leeren.
CREDENTIALS_ENCRYPTION_KEY_OLD=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Session-Cookies nur über HTTPS senden. Nur für lokale HTTP-Entwicklung auf false setzen;
# in production verweigert das Backend den Start mit false.
SESSION_COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Erster Admin: docker compose run --rm backend python -m app.create_admin --email <mail>
# (Passwort wird abgefragt; nie als Kommandozeilenargument übergeben.)

# --- Private Nutzung (nur der Betreiber, siehe docs/PRIVATE_ACCESS.md) ---
# true: keine weiteren Benutzerkonten (Dashboard und CLI). Für den Server empfohlen.
SINGLE_USER_MODE=false
# cloudflare: jede API-Anfrage (außer /api/health) braucht ein gültiges Cloudflare-Access-Token.
# none: keine Prüfung (lokale Entwicklung).
ACCESS_GUARD=none
# Team-Domain der Zero-Trust-Organisation, z. B. meinteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" der Access-Anwendung (kein Geheimnis, aber nur hier eintragen)
CF_ACCESS_AUD=
# Optional: erlaubte E-Mail-Adressen, kommagetrennt (zweite Prüfung hinter Access)
CF_ACCESS_ALLOWED_EMAILS=
# Token des Cloudflare Tunnels (GEHEIM, nur in .env auf dem Server). Leer = kein Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2026.10.5

# --- Veröffentlichung: SICHERE STANDARDWERTE, NICHT ÄNDERN während der Entwicklung ---
AUTO_PUBLISH_ENABLED=false     # Spezifikation Abschnitt 15: standardmäßig AUS
PUBLISHING_MODE=mock           # mock | live  (live erst nach Freigabe durch den Betreiber)
EMERGENCY_STOP=false           # Not-Aus: true stoppt alle Agenten und Veröffentlichungen
PAID_API_CALLS_ENABLED=false   # Kostenpflichtige KI-/API-Aufrufe nur nach ausdrücklicher Freigabe

# --- Budget ---
MONTHLY_BUDGET_EUR=50
BUDGET_WARN_PCT=50
BUDGET_REDUCED_PCT=70
BUDGET_PRIORITY_ONLY_PCT=85
BUDGET_STOP_PAID_PCT=95
# Fixkosten pro Monat (Phase 14): erst nach Prüfung der aktuellen Anbieterpreise eintragen.
# Sie zählen von Monatsbeginn an voll gegen das Budget.
SERVER_MONTHLY_EUR=0
OTHER_FIXED_MONTHLY_EUR=0          # Backups, Domain, …
STORAGE_EUR_PER_GB_MONTH=0

# --- Agenten / Zeitsteuerung (Phase 4) ---
MASTER_TICK_SECONDS=300        # Wie oft der Master Orchestrator Aufträge verteilt
BUDGET_CHECK_SECONDS=3600      # Wie oft der Budget-Agent die Kosten prüft
MASTER_BATCH_SIZE=25           # Höchstens so viele Einträge pro Stufe und Durchlauf
STRATEGY_INTERVAL_MINUTES=60
AGENT_MAX_RETRIES=3            # Automatische Wiederholungen nach einem Fehler
AGENT_RETRY_BASE_DELAY_S=300   # Wartezeit vor der 1. Wiederholung (verdoppelt sich)
TREND_RESEARCH_SECONDS=21600   # Trend Research alle 6 Stunden
ANALYTICS_SECONDS=1800          # Analytics misst Posts nach 1 h, 6 h, 24 h, 48 h und 7 Tagen
ANALYTICS_BATCH_SIZE=500
LEARNING_SECONDS=21600          # Learning Agent prüft Tests und leitet neue Faktoren ab
GAME_INTELLIGENCE_SECONDS=86400
RIGHTS_SWEEP_SECONDS=86400      # Lizenz-Ablaufüberwachung täglich
MATERIAL_NEEDS_SECONDS=86400

# --- Betrieb: Überwachung und Datensicherung (Phase 15) ---
MONITOR_SECONDS=60              # Systemprüfung durch die Zeitsteuerung
# Optional: Push-URL eines Uptime-Kuma-Push-Monitors (enthält ein Token, nie einchecken)
UPTIME_KUMA_PUSH_URL=
DISK_WARN_PCT=80
DISK_CRITICAL_PCT=90
QUEUE_WAIT_WARN_S=1800          # Wartezeit in der Warteschlange, ab der gewarnt wird
AGENT_ERROR_WARN_RATIO=0.2
BACKUP_DIR=/data/backups
# Schlüssel für die verschlüsselten Datenbanksicherungen (mind. 16 Zeichen). Ohne ihn wird
# nichts gesichert. Zusätzlich außerhalb des Servers aufbewahren, sonst sind die Sicherungen
# nicht lesbar. Erzeugen z. B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BACKUP_PASSPHRASE=
BACKUP_HOUR=3                   # tägliche Sicherung um 3 Uhr (Zeitzone TZ)
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=3
BACKUP_MAX_AGE_HOURS=30         # ältere letzte Sicherung = Alarm

# --- Dateiablage (Lizenznachweise; später Cloudflare R2) ---
MEDIA_ROOT=/data/media
MAX_DOCUMENT_BYTES=10485760

# --- Trendquellen (Phase 5) ---
# mock = Testdaten ohne Netzwerkzugriff. live erst nach Freigabe und mit eigenen Schlüsseln.
TREND_SOURCES_MODE=mock
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_UNITS=2000   # eigene Obergrenze pro Tag (Google-Quote liegt höher)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_MAX_REQUESTS_PER_RUN=20
STEAM_MAX_REQUESTS_PER_RUN=30

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gce
POSTGRES_USER=gce
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- n8n (optional, Profil "workflow") ---
N8N_VERSION=stable
N8N_ENCRYPTION_KEY=change-me
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Caddy / Domain (Phase 15) ---
# Mit Cloudflare Tunnel (private Nutzung): DOMAIN=localhost lassen und CADDY_BIND=127.0.0.1,
# dann sind die Ports 80/443 von außen geschlossen. Ohne Tunnel: DOMAIN=<eigene Domain>.
DOMAIN=localhost
ACME_EMAIL=                 # required: Caddy does not start without it (also behind the tunnel)
CADDY_BIND=0.0.0.0
# Statische Rechtstext-Seite für Google/Meta (eigener Hostname über den Tunnel -> caddy:8081).
# Werte nur hier in der .env auf dem Server eintragen, nie im Repository.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_UPDATED=

# --- Cloudflare R2 (Objektspeicher, Phase 7) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gce-media
R2_ENDPOINT=
R2_PRESIGN_SECONDS=900             # Lebensdauer der signierten Video-Adresse für Instagram (E8)

# Trendquellen: YOUTUBE_API_KEY, TWITCH_CLIENT_ID und TWITCH_CLIENT_SECRET stehen oben im
# Abschnitt „Trendquellen“ (jede Variable nur einmal eintragen). Steam braucht keinen Schlüssel.

# --- Publishing-Plattformen (Phase 12/13) – leer lassen = Mock ---
# OAuth-Tokens werden NICHT hier, sondern verschlüsselt in der Datenbank gespeichert.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# muss exakt so im Google-OAuth-Client als Weiterleitungs-URI eingetragen sein
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
YOUTUBE_UPLOAD_PRIVACY=private     # private | unlisted | public – Standard bleibt privat
YOUTUBE_DAILY_UPLOAD_LIMIT=100     # eigene Obergrenze für Uploads pro Tag (Google: 100 videos.insert/Tag)
PUBLISH_UPLOAD_ATTEMPTS=5          # Fortsetzungsversuche eines abgebrochenen Uploads
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok akzeptiert nur https-Weiterleitungen: auf dem Server die Dashboard-Domain eintragen
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback
TIKTOK_PRIVACY_LEVEL=SELF_ONLY     # nicht geprüfte Apps dürfen nur privat posten
TIKTOK_APP_AUDITED=false           # erst nach bestandenem TikTok-Audit auf true
TIKTOK_DAILY_POST_LIMIT=5          # eigene Obergrenze je Kanal und Tag
TIKTOK_POST_MODE=inbox             # inbox = Entwurf in die TikTok-App (Standard), direct = Direct Post
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
INSTAGRAM_DAILY_POST_LIMIT=50      # Meta: 50 API-Posts je 24 h
# Instagram ohne Facebook-Seite (Erweiterung E8): Instagram-Login; braucht R2 (siehe oben)
INSTAGRAM_LOGIN=instagram          # instagram = Instagram-Login, facebook = über eine Facebook-Seite
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
FACEBOOK_DAILY_REELS_LIMIT=30      # Meta: 30 Reels je Seite und 24 h
PUBLISH_STATUS_POLLS=10            # Statusabfragen nach dem Upload
PUBLISH_STATUS_INTERVAL_SECONDS=30

# --- KI-Schicht (Erweiterung E3): Claude, harte Monatsgrenze ---
# Schlüssel nur auf dem Server bzw. im Secret-Manager setzen, nie einchecken.
# Live-Aufrufe zusätzlich nur mit PAID_API_CALLS_ENABLED=true und Anbieter „Claude“
# in den Einstellungen; sonst bleibt alles im kostenlosen Mock-Modus.
ANTHROPIC_API_KEY=
AI_MONTHLY_CAP_USD_MAX=20          # harte Obergrenze in US-Dollar je Monat (Dashboard kann nur senken)
AI_MODEL_TEXT=claude-haiku-5-5     # kurze Texte: Titel, Beschreibungen, Hooks
AI_MODEL_REASONING=claude-sonnet-5-5   # Chat, Ideen, Planung
EUR_PER_USD=0.92                   # Umrechnung für die Buchung ins Euro-Budget
AI_MAX_INPUT_CHARS=60000           # längster Prompt je Aufruf
AI_REQUEST_TIMEOUT_S=60

# --- KI- und TTS-Anbieter (Phase 8/9) – leer lassen = lokale/Mock-Verarbeitung ---
LLM_PROVIDER=mock
LLM_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=

# --- Piper-Stimme (Entscheidung 16.11.2026): lokal, kostenlos ---
# Stimme im Dashboard unter Einstellungen → Betrieb wählen. Stimmen einmal laden:
#   docker compose exec backend python -m app.piper_voices fetch
# Nur Stimmen mit Lizenz für kommerzielle Nutzung (CC0 / Public Domain), Prüfsumme festgelegt.
PIPER_BIN=piper
PIPER_VOICE_DIR=./data/piper-voices
PIPER_VOICE_DE=de_DE-thorsten-medium
PIPER_VOICE_EN=en_US-ljspeech-high

# --- Research feeds and idea lab (extension E5) ---
RESEARCH_SOURCES_MODE=mock       # mock = sample feeds, no network; live = fetch the RSS/Atom feeds
RESEARCH_SECONDS=21600           # research run every 6 h
IDEAS_SECONDS=86400              # idea lab once a day (counts against the AI cap with Claude)
IDEAS_PER_RUN=5

# --- Media library and own production (extension E7) ---
LIBRARY_MAX_RENDITION_S=180      # longer uploads keep only the original (no 9:16 copy)
LIBRARY_MAX_IMAGE_BYTES=26214400 # 25 MB per image
LIBRARY_SWEEP_SECONDS=600        # pick up library files whose processing is still open
LIBRARY_ORIGINAL_RETENTION_DAYS=30  # Originale hochgeladener Videos nach 30 Tagen löschen (0 = behalten), 9:16-Fassung bleibt
PRODUCTION_MAX_SEGMENTS=12
PRODUCTION_MIN_SEGMENT_S=2.5
PRODUCTION_MAX_S=180             # longest own production in seconds

# --- Kanal-Assistent: E-Mail-Weiterleitungen für neue Konten (Cloudflare Email Routing) ---
# mock = Adresse wird nur vorgeschlagen; live = Weiterleitungsregel wird bei Cloudflare angelegt.
MAIL_ROUTING_MODE=mock
MAIL_ALIAS_DOMAIN=              # z. B. kanalfabrik.de (Email Routing in Cloudflare aktiviert)
MAIL_FORWARD_TO=                # Zielpostfach, bei Cloudflare als Zieladresse bestätigt
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=           # nur Recht "Zone > Email Routing Rules > Edit" für diese Zone

# --- Konten-Übersicht (A2) ---
ACCOUNT_REVIEW_DAYS=90          # Kanal wird erst 90 Tage nach dem ersten Beitrag bewertet
ACCOUNT_WEAK_SHARE=0.25         # "schwach" = unter 25 % des Medians im Themenbereich (Aufrufe je Beitrag)
ACCOUNT_MIN_VIEWS_PER_POST=200  # Untergrenze, wenn es keine Vergleichskanäle gibt

# --- Kommentare (A3) ---
COMMENT_AUTO_REPLY=true         # false = jede Antwort wartet auf Freigabe im Dashboard
COMMENT_MOCK_SAMPLES=true       # Testkommentare für Mock-Beiträge erzeugen
COMMENTS_SECONDS=1800           # Abruf alle 30 Minuten
COMMENT_LOOKBACK_DAYS=14        # Kommentare zu Beiträgen der letzten 14 Tage
COMMENT_POSTS_PER_RUN=20
COMMENT_DRAFTS_PER_RUN=30
COMMENT_REPLIES_PER_RUN=10      # höchstens so viele Antworten je Lauf

# --- Warnsystem und Push aufs Handy (A4, ntfy) ---
# mock = Hinweise nur im Dashboard (Glocke); live = wichtige zusätzlich per ntfy aufs Handy.
PUSH_MODE=mock
PUSH_NTFY_URL=                  # z. B. https://ntfy.sh/<langer-zufaelliger-name>; der Name ist das Geheimnis
PUSH_NTFY_TOKEN=                # optional: Zugangstoken für ein geschütztes Thema / eigenen ntfy-Server
PUSH_CLICK_BASE_URL=            # z. B. https://studio.kanalfabrik.de (Tippen öffnet die passende Seite)
PUSH_MIN_LEVEL=warning          # info | warning | error | critical
PUSH_QUIET_START=22             # Ruhezeit (Ortszeit), nur Notfälle; danach eine Sammelmeldung
PUSH_QUIET_END=7
WATCHDOG_SECONDS=900            # Warnsystem prüft alle 15 Minuten
WATCHDOG_REPEAT_HOURS=24        # gleiche Warnung höchstens einmal je 24 Stunden
CHAT_MAX_ATTACHMENTS=5

# --- Konkurrenz-Radar (A5) ---
# Echte Daten nur mit YOUTUBE_API_KEY und TREND_SOURCES_MODE=live (2–3 Einheiten je Kanal und Lauf).
COMPETITOR_SECONDS=43200        # alle 12 Stunden
