# =====================================================================
# Gaming Content Engine – Beispielkonfiguration
# Kopieren nach .env und Werte setzen. Die .env wird NIE eingecheckt.
# Alle Werte mit "change-me" MÜSSEN vor dem Start ersetzt werden.
# =====================================================================

# --- Allgemein ---
APP_ENV=development            # development | staging | production
APP_NAME=gaming-content-engine
LOG_LEVEL=INFO
TZ=Europe/Berlin

# --- Sicherheit (Phase 2/3) ---
# Erzeugen z. B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
# Schlüssel zur Verschlüsselung gespeicherter Plattform-Tokens (Fernet, 32 Byte base64)
# Erzeugen mit: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Session-Cookies nur über HTTPS senden. Nur für lokale HTTP-Entwicklung auf false setzen;
# in production verweigert das Backend den Start mit false.
SESSION_COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Erster Admin: docker compose run --rm backend python -m app.create_admin --email <mail>
# (Passwort wird abgefragt; nie als Kommandozeilenargument übergeben.)

# --- Veröffentlichung: SICHERE STANDARDWERTE, NICHT ÄNDERN während der Entwicklung ---
AUTO_PUBLISH_ENABLED=false     # Spezifikation Abschnitt 15: standardmäßig AUS
PUBLISHING_MODE=mock           # mock | live  (live erst nach Freigabe durch den Betreiber)
EMERGENCY_STOP=false           # Not-Aus: true stoppt alle Agenten und Veröffentlichungen
PAID_API_CALLS_ENABLED=false   # Kostenpflichtige KI-/API-Aufrufe nur nach ausdrücklicher Freigabe

# --- Budget ---
MONTHLY_BUDGET_EUR=50
BUDGET_WARN_PCT=50
BUDGET_REDUCED_PCT=70
BUDGET_PRIORITY_ONLY_PCT=85
BUDGET_STOP_PAID_PCT=95

# --- Agenten / Zeitsteuerung (Phase 4) ---
MASTER_TICK_SECONDS=300        # Wie oft der Master Orchestrator Aufträge verteilt
BUDGET_CHECK_SECONDS=3600      # Wie oft der Budget-Agent die Kosten prüft
MASTER_BATCH_SIZE=25           # Höchstens so viele Einträge pro Stufe und Durchlauf
STRATEGY_INTERVAL_MINUTES=60
AGENT_MAX_RETRIES=3            # Automatische Wiederholungen nach einem Fehler
AGENT_RETRY_BASE_DELAY_S=300   # Wartezeit vor der 1. Wiederholung (verdoppelt sich)
TREND_RESEARCH_SECONDS=21600   # Trend Research alle 6 Stunden
GAME_INTELLIGENCE_SECONDS=86400
RIGHTS_SWEEP_SECONDS=86400      # Lizenz-Ablaufüberwachung täglich
MATERIAL_NEEDS_SECONDS=86400

# --- Dateiablage (Lizenznachweise; später Cloudflare R2) ---
MEDIA_ROOT=/data/media
MAX_DOCUMENT_BYTES=10485760

# --- Trendquellen (Phase 5) ---
# mock = Testdaten ohne Netzwerkzugriff. live erst nach Freigabe und mit eigenen Schlüsseln.
TREND_SOURCES_MODE=mock
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_UNITS=2000   # eigene Obergrenze pro Tag (Google-Quote liegt höher)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_MAX_REQUESTS_PER_RUN=20
STEAM_MAX_REQUESTS_PER_RUN=30

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gce
POSTGRES_USER=gce
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- n8n (optional, Profil "workflow") ---
N8N_VERSION=stable
N8N_ENCRYPTION_KEY=change-me
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Caddy / Domain (Phase 15) ---
DOMAIN=localhost
ACME_EMAIL=

# --- Cloudflare R2 (Objektspeicher, Phase 7) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gce-media
R2_ENDPOINT=

# Trendquellen: YOUTUBE_API_KEY, TWITCH_CLIENT_ID und TWITCH_CLIENT_SECRET stehen oben im
# Abschnitt „Trendquellen“ (jede Variable nur einmal eintragen). Steam braucht keinen Schlüssel.

# --- Publishing-Plattformen (Phase 12/13) – leer lassen = Mock ---
# OAuth-Tokens werden NICHT hier, sondern verschlüsselt in der Datenbank gespeichert.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# muss exakt so im Google-OAuth-Client als Weiterleitungs-URI eingetragen sein
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
YOUTUBE_UPLOAD_PRIVACY=private     # private | unlisted | public – Standard bleibt privat
YOUTUBE_DAILY_UPLOAD_LIMIT=100     # eigene Obergrenze für Uploads pro Tag (Google: 100 videos.insert/Tag)
PUBLISH_UPLOAD_ATTEMPTS=5          # Fortsetzungsversuche eines abgebrochenen Uploads
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# --- KI- und TTS-Anbieter (Phase 8/9) – leer lassen = lokale/Mock-Verarbeitung ---
LLM_PROVIDER=mock
LLM_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=
