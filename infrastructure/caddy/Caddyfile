# Caddy Reverse Proxy (Stand: Phase 2)
# /api/* geht an das Backend; das Frontend folgt in Phase 3.
{
	email {$ACME_EMAIL}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Phase 3: handle { reverse_proxy frontend:3000 }

	handle {
		respond "Gaming Content Engine – Dashboard folgt in Phase 3" 200
	}
}
