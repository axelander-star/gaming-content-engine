# Caddy Reverse Proxy (Stand: private Nutzung, 15.11.2026)
# /api/* geht an das Backend, alles andere an das Dashboard.
{
	email {$ACME_EMAIL}
}

# Routes and headers shared by both entry points.
(app) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Phase 15: no framing, no plugins, no foreign base URLs; no browser features.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Public entry point with automatic HTTPS (Let's Encrypt) for DOMAIN.
# In private operation behind Cloudflare Tunnel leave DOMAIN empty: this block then
# only answers on localhost, and ports 80/443 stay closed (CADDY_BIND=127.0.0.1).
{$DOMAIN:localhost} {
	import app
}

# Internal entry point for Cloudflare Tunnel (cloudflared -> http://caddy:8080).
# Not published on the host; TLS ends at Cloudflare, the tunnel itself is encrypted.
http://:8080 {
	import app
}
