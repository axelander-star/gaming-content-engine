# Caddy Reverse Proxy (Stand: private Nutzung, 15.11.2026)
# /api/* geht an das Backend, alles andere an das Dashboard.
{
	email {$ACME_EMAIL}
}

# Routes and headers shared by both entry points.
(app) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Phase 15: no framing, no plugins, no foreign base URLs; no browser features.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Public entry point with automatic HTTPS (Let's Encrypt) for DOMAIN.
# In private operation behind Cloudflare Tunnel leave DOMAIN empty: this block then
# only answers on localhost, and ports 80/443 stay closed (CADDY_BIND=127.0.0.1).
{$DOMAIN:localhost} {
	import app
}

# Static legal page (privacy policy and terms for the Google and Meta apps).
# Separate entry point for its own hostname (e.g. rechtliches.<domain>, tunnel ->
# http://caddy:8081). It serves exactly one static file and has no route to the
# dashboard or the API, so it cannot open a way into the application.
http://:8081 {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	@page {
		method GET HEAD
		path / /index.html /datenschutz /nutzungsbedingungen /privacy /terms
	}
	handle @page {
		root * /srv/legal
		rewrite * /index.html
		templates
		file_server
	}
	handle {
		respond "Not found" 404
	}
}

# Internal entry point for Cloudflare Tunnel (cloudflared -> http://caddy:8080).
# Not published on the host; TLS ends at Cloudflare, the tunnel itself is encrypted.
http://:8080 {
	import app
}
